{
  "createChange": {
    "description": "create requires key, type, and record; node types such as objective and attempt belong in type, never op",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "op",
      "key",
      "type",
      "record"
    ],
    "properties": {
      "op": {
        "const": "create"
      },
      "key": {
        "$ref": "#/$defs/blackboardKey"
      },
      "type": {
        "$ref": "#/$defs/creatableRecordType"
      },
      "record": {
        "type": "object"
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "type": {
              "const": "entity"
            }
          }
        },
        "then": {
          "properties": {
            "record": {
              "$ref": "#/$defs/entityRecord"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "objective"
            }
          }
        },
        "then": {
          "properties": {
            "record": {
              "$ref": "#/$defs/objectiveRecord"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "attempt"
            }
          }
        },
        "then": {
          "properties": {
            "record": {
              "$ref": "#/$defs/attemptRecord"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "fact"
            }
          }
        },
        "then": {
          "properties": {
            "record": {
              "$ref": "#/$defs/factRecord"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "finding"
            }
          }
        },
        "then": {
          "properties": {
            "record": {
              "$ref": "#/$defs/findingInputRecord"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "solution"
            }
          }
        },
        "then": {
          "properties": {
            "record": {
              "$ref": "#/$defs/solutionRecord"
            }
          }
        }
      }
    ]
  },
  "updateChange": {
    "type": "object",
    "additionalProperties": false,
    "required": [
