              "clear"
            ]
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "fact"
            }
          }
        },
        "then": {
          "properties": {
            "record": {
              "$ref": "#/$defs/factPartial"
            },
            "clear": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "const": "body"
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "finding"
            }
          }
        },
        "then": {
          "properties": {
            "record": {
              "$ref": "#/$defs/findingPartial"
            },
            "clear": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "target",
                  "description",
                  "proof",
                  "impact",
                  "recommendation",
                  "cvss_version",
                  "cvss_vector"
                ]
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "solution"
            }
          }
        },
        "then": {
          "properties": {
            "record": {
              "$ref": "#/$defs/solutionPartial"
            },
            "clear": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "value",
                  "verification_summary"
                ]
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "evidence"
            }
          }
        },
        "then": {
          "properties": {
            "record": {
              "$ref": "#/$defs/evidencePartial"
            },
            "clear": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "media_type",
                  "captured_at"
                ]
              }
            }
          }
        }
      }
    ]
  },
