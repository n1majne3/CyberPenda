  "change": {
    "description": "operation kind is a verb: create creates a record; update patches a record; transition changes lifecycle status; supported ops are create, update, transition, relate, unrelate, merge, and supersede; record types such as objective and attempt belong in type, never op",
    "oneOf": [
      {
        "$ref": "#/$defs/createChange"
      },
      {
        "$ref": "#/$defs/updateChange"
      },
      {
        "$ref": "#/$defs/transitionChange"
      },
      {
        "$ref": "#/$defs/relateChange"
      },
      {
        "$ref": "#/$defs/unrelateChange"
      },
      {
        "$ref": "#/$defs/mergeChange"
      },
      {
        "$ref": "#/$defs/supersedeChange"
      }
    ]
  },
  "changeBatch": {
    "description": "Atomic semantic-change-batch/v2: schema is always semantic-change-batch/v2; idempotency_key is required for exact replay; changes is a closed list of semantic ops. op is a verb: create creates a record; update patches a record; transition changes lifecycle status; relate/unrelate manage relationships; merge and supersede rewrite knowledge. Record types such as objective and attempt belong in type, never op. create requires key, type, and record.",
    "examples": [
      {
        "schema": "semantic-change-batch/v2",
        "idempotency_key": "attempt-with-tests",
        "changes": [
          {
            "op": "create",
            "key": "objective:sample",
            "type": "objective",
            "record": {
              "status": "open",
              "objective": "Test the sample target."
            }
          },
          {
            "op": "create",
            "key": "attempt:sample",
            "type": "attempt",
            "record": {
              "status": "open",
              "summary": "Started the sample test."
            }
          },
          {
            "op": "relate",
            "from": "attempt:sample",
            "relation": "tests",
            "to": "objective:sample"
          }
        ]
      }
    ],
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "idempotency_key",
      "changes"
    ],
    "properties": {
      "schema": {
        "const": "semantic-change-batch/v2"
      },
      "idempotency_key": {
        "type": "string",
        "minLength": 1
      },
      "changes": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/change"
        }
      }
    }
  }
}
