{
  "evidenceLink": {
    "type": "array",
    "minItems": 2,
    "maxItems": 2,
    "prefixItems": [
      {
        "enum": [
          "evidences",
          "about"
        ]
      },
      {
        "$ref": "#/$defs/blackboardKey"
      }
    ],
    "items": false
  },
  "retainEvidenceRequest": {
    "examples": [
      {
        "idempotency_key": "retain-sample",
        "key": "evidence:sample",
        "attempt": "attempt:sample",
        "source_path": "captures/sample.txt",
        "artifact_type": "text",
        "summary": "Captured sample response."
      }
    ],
    "type": "object",
    "additionalProperties": false,
    "required": [
      "idempotency_key",
      "key",
      "attempt",
      "source_path",
      "artifact_type",
      "summary"
    ],
    "properties": {
      "idempotency_key": {
        "type": "string",
        "minLength": 1
      },
      "key": {
        "$ref": "#/$defs/blackboardKey"
      },
      "version": {
        "$ref": "#/$defs/version"
      },
      "attempt": {
        "$ref": "#/$defs/blackboardKey"
      },
      "source_path": {
        "type": "string",
        "minLength": 1
      },
      "artifact_type": {
        "$ref": "#/$defs/conciseText"
      },
      "summary": {
        "$ref": "#/$defs/semanticText"
      },
      "media_type": {
        "$ref": "#/$defs/conciseText"
      },
      "captured_at": {
        "type": "string",
        "format": "date-time"
      },
      "links": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/evidenceLink"
        }
      }
    }
  },
  "checkpointAttemptRequest": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "idempotency_key",
      "key",
      "version",
      "summary"
    ],
    "properties": {
      "idempotency_key": {
        "type": "string",
        "minLength": 1
      },
      "key": {
        "$ref": "#/$defs/blackboardKey"
      },
      "version": {
        "$ref": "#/$defs/version"
      },
      "summary": {
        "$ref": "#/$defs/semanticText"
      }
    }
  },
  "attemptResultRequest": {
    "examples": [
      {
        "idempotency_key": "attempt-result-sample",
        "result": {
          "schema": "runtime-attempt-result/v1",
          "base_revision": 0,
          "attempt": {
            "key": "attempt:sample",
            "create": true,
            "summary": "Tested the sample target.",
            "outcome": "failed"
          },
          "tested_targets": [
            {
              "key": "objective:sample",
              "create_objective": {
                "objective": "Test the sample target."
              }
            }
          ],
          "produced_targets": []
        }
      }
    ],
    "type": "object",
    "additionalProperties": false,
    "required": [
      "idempotency_key",
      "result"
    ],
    "properties": {
      "idempotency_key": {
        "type": "string",
        "minLength": 1
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "base_revision",
          "attempt",
          "tested_targets",
          "produced_targets"
        ],
        "properties": {
          "schema": {
            "const": "runtime-attempt-result/v1"
          },
          "base_revision": {
            "$ref": "#/$defs/revision"
          },
          "attempt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "summary",
              "outcome"
            ],
            "properties": {
              "key": {
                "$ref": "#/$defs/blackboardKey"
              },
              "create": {
                "const": true
              },
              "expected_version": {
                "$ref": "#/$defs/version"
              },
              "summary": {
                "$ref": "#/$defs/semanticText"
              },
              "outcome": {
                "enum": [
                  "succeeded",
                  "failed",
                  "blocked",
                  "inconclusive"
                ]
              }
            },
            "oneOf": [
              {
                "required": [
                  "create"
                ],
                "not": {
                  "required": [
                    "expected_version"
                  ]
                }
              },
              {
                "required": [
                  "expected_version"
                ],
                "not": {
                  "required": [
                    "create"
                  ]
                }
              }
            ]
          },
          "tested_targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key"
              ],
              "properties": {
                "key": {
                  "$ref": "#/$defs/blackboardKey"
                },
                "expected_version": {
                  "$ref": "#/$defs/version"
                },
                "create_objective": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "objective"
                  ],
                  "properties": {
                    "objective": {
                      "$ref": "#/$defs/semanticText"
                    }
                  }
                }
              }
            }
          },
          "produced_targets": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "expected_version"
              ],
              "properties": {
                "key": {
                  "$ref": "#/$defs/blackboardKey"
                },
                "expected_version": {
                  "$ref": "#/$defs/version"
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "attempt": {
                  "properties": {
                    "outcome": {
                      "const": "succeeded"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "produced_targets": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "finishRequest": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "idempotency_key"
    ],
    "properties": {
      "idempotency_key": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "finishResult": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "status",
      "revision",
      "working_snapshot"
    ],
    "properties": {
      "schema": {
        "const": "continuation-finish/v2"
      },
      "status": {
        "enum": [
          "finished",
          "intent_recorded"
        ]
      },
      "revision": {
        "$ref": "#/$defs/revision"
      },
      "working_snapshot": {
        "$ref": "#/$defs/workingSnapshot"
      },
      "sync": {
        "$ref": "#/$defs/syncAttachment"
      }
    }
  }
}
