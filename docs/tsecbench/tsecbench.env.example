# TSecBench page variables. Secret values must be entered on the page and
# must not be stored in this template.
# codex, claude_code, or pi. Default is codex.
CYBERPENDA_RUNTIME=codex
# openai_responses for codex; anthropic_messages for claude_code;
# openai_chat_completions, openai_responses, or anthropic_messages for pi.
CYBERPENDA_MODEL_PROTOCOL=openai_responses
CYBERPENDA_MODEL_BASE_URL=http://MODEL_HOST.tsecbench.gw/v1
CYBERPENDA_MODEL=MODEL_ID
CYBERPENDA_MODEL_API_KEY=
CYBERPENDA_REASONING_EFFORT=high
CYBERPENDA_TASK_GOAL_APPENDIX=
# Claude Code only. Integer 1-100. Empty keeps the Claude default.
CYBERPENDA_AUTO_COMPACT_THRESHOLD=
# Claude Code only. Integer 1-1048576. Empty keeps the Claude default.
# DeepSeek documents 786432. With 384K max output, use 524288.
CYBERPENDA_AUTO_COMPACT_WINDOW=
# Claude Code 和 Pi 的最大输出 token。整数 1-1048576。
# 留空时使用模型能力缓存或 Runtime 默认值。
# DeepSeek hosted runs should use 393216 (384K).
CYBERPENDA_MAX_OUTPUT_TOKENS=
# 模型总 context window，含输入和输出。整数 1-1048576。
# Claude Code 和 Pi 共用；与上面的自动压缩窗口独立。
# 留空时使用模型能力缓存或 Runtime 默认值。
CYBERPENDA_CONTEXT_WINDOW=

# Pi only: optional additional models for the projected Pi profile. Slots 1-3.
# Unlike the settings above, these MUST stay commented out when unused:
# a present-but-empty value fails configuration validation, and an override
# without its model id fails too. Each _PROTOCOL/_BASE_URL/_API_KEY override
# is independent; an omitted override inherits CYBERPENDA_MODEL_*.
# Setting any of these on codex or claude_code fails validation.
# Example 1: inherit the parent provider (protocol, base URL, and key).
#CYBERPENDA_PI_ADDITIONAL_MODEL_1=ADDITIONAL_MODEL_ID
# Example 2: a model served by a second Hosted gateway and its own key.
#CYBERPENDA_PI_ADDITIONAL_MODEL_2=SECOND_MODEL_ID
#CYBERPENDA_PI_ADDITIONAL_MODEL_2_BASE_URL=http://SECOND_HOST.tsecbench.gw/v1
#CYBERPENDA_PI_ADDITIONAL_MODEL_2_API_KEY=SECOND_DEDICATED_KEY
# The same gateway rules apply: HTTP, .tsecbench.gw host, no operation suffix.
#CYBERPENDA_PI_ADDITIONAL_MODEL_2_PROTOCOL=openai_chat_completions

# Challenge Platform adapter. Default tsecbench. Overlay JSON without rebuild:
# /data/adapters/<id>.json and CYBERPENDA_CHALLENGE_ADAPTER=<id>
CYBERPENDA_CHALLENGE_ADAPTER=tsecbench

# TSecBench injects BENCHMARK_BASE_URL and BENCHMARK_TOKEN in Hosted Mode.
# Do not add BENCHMARK_TOKEN to this file.
