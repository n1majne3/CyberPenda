# TSecBench page variables. Secret values must be entered on the page and
# must not be stored in this template.
CYBERPENDA_RUNTIME=pi
CYBERPENDA_MODEL_PROTOCOL=openai_chat_completions
CYBERPENDA_MODEL_BASE_URL=http://MODEL_HOST.tsecbench.gw/v1
CYBERPENDA_MODEL=MODEL_ID
CYBERPENDA_MODEL_API_KEY=

# TSecBench injects BENCHMARK_BASE_URL and BENCHMARK_TOKEN in Hosted Mode.
# Do not add BENCHMARK_TOKEN to this file.
